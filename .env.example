# Copy to .env and fill in. .env is git-ignored - never commit real keys.

# Google AI Studio key: https://aistudio.google.com/apikey
# Leave empty to run offline (retrieval only, lexical embeddings, no generated answers).
GEMINI_API_KEY=

# Generation model. "gemini-flash-latest" is Google's alias for the current stable Flash
# model; pin a specific version (e.g. gemini-3.8-flash) for reproducible behaviour.
GEMINI_MODEL=gemini-flash-latest

# Embedding model and output dimension (768, 1536 or 3072 for gemini-embedding-001).
# Changing either creates a new vector collection; re-index documents in the Knowledge Base.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# auto = Gemini when a key is set, otherwise offline lexical embeddings | gemini | local
EMBEDDING_PROVIDER=auto

CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_MB=20

RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
# Drop retrieved chunks below this cosine similarity (0 = keep all top-k).
RAG_MIN_SIMILARITY=0.0
RAG_MAX_CONTEXT_CHARS=12000

GEMINI_TIMEOUT_S=60
GEMINI_MAX_RETRIES=3

# true = each browser session gets its own temporary knowledge base (use for public hosting).
DOCUMIND_SESSION_ISOLATION=false
