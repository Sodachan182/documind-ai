# Copy to .env and fill in. .env is git-ignored - never commit real keys.
# Hosted deployments: put the same names in Streamlit secrets instead.

# ----------------------------------------------------------------------------
# Answer generation
# ----------------------------------------------------------------------------
# auto (default) = gemini if GEMINI_API_KEY is set, else shopaikey if SHOPAIKEY_API_KEY
# is set, else offline. Explicit values: gemini | shopaikey | offline
DOCUMIND_LLM_PROVIDER=auto

# Direct Google Gemini API - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" is Google's alias for the current stable Flash model.
GEMINI_MODEL=gemini-flash-latest

# ShopAIKey gateway (third-party; https://shopaikey.com/docs/quickstart)
# Your questions and retrieved document excerpts are sent to the gateway when it is used.
SHOPAIKEY_API_KEY=
# Gateway root. "/v1" is accepted and normalised; the OpenAI-format SDK adds /v1,
# the Anthropic- and Gemini-format SDKs use the root. Official vendor hosts are refused.
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
# openai | anthropic | gemini
SHOPAIKEY_PROTOCOL=openai
# Exact model ID available to your key's model group (see Settings > Load models).
SHOPAIKEY_MODEL=

# Cost / safety limits for every provider
DOCUMIND_MAX_OUTPUT_TOKENS=1024
DOCUMIND_REQUEST_TIMEOUT_S=60
# Transient errors only (429/5xx/timeouts); balance, auth and model errors are never retried.
DOCUMIND_MAX_RETRIES=2

# ----------------------------------------------------------------------------
# Embeddings (independent of answer generation)
# ----------------------------------------------------------------------------
# auto (default) = gemini if GEMINI_API_KEY is set, else offline.
# gemini | shopaikey | offline. ShopAIKey embeddings are opt-in and need the model and dimension.
# Changing provider, model or dimension creates a new vector space: re-index on the Documents page.
DOCUMIND_EMBEDDING_PROVIDER=auto
# Empty = provider default (Gemini: GEMINI_EMBEDDING_MODEL). Required for shopaikey.
DOCUMIND_EMBEDDING_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Gemini: 768, 1536 or 3072. ShopAIKey: the model's native output size (checked on every call).
DOCUMIND_EMBEDDING_DIMENSION=768

# ----------------------------------------------------------------------------
# Retrieval and storage
# ----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_MB=20
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
# Drop retrieved chunks below this cosine similarity (0 = keep all top-k).
RAG_MIN_SIMILARITY=0.0
RAG_MAX_CONTEXT_CHARS=12000

# true = each browser session gets its own temporary knowledge base (use for public hosting).
DOCUMIND_SESSION_ISOLATION=false

# Legacy names still accepted: EMBEDDING_PROVIDER, GEMINI_EMBEDDING_DIMENSION,
# GEMINI_TIMEOUT_S, GEMINI_MAX_RETRIES, GOOGLE_API_KEY.
